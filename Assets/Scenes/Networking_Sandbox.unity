--- !u!114 &2010418730
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2010418724}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e2fcf7f3834392245a36dea5c40572f3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NetworkReadableNote
  ShowTopMostFoldoutHeaderGroup: 1
  noteTitle: "\u0410\u0420\u0425\u0406\u0412\u041D\u0418\u0419 \u041F\u0420\u041E\u0422\u041E\u041A\u041E\u041B \u211614-\u0411"
  noteAuthor: "\u0421\u0442. \u0456\u043D\u0436\u0435\u043D\u0435\u0440 \u041E. \u041A\u043E\u0432\u0430\u043B\u044C\u0447\u0443\u043A (14.11.1987)"
  noteBodyText: "\u0421\u043B\u0443\u0436\u0431\u043E\u0432\u0430 \u0437\u0430\u043F\u0438\u0441\u043A\u0430 \u0434\u043B\u044F \u0437\u043C\u0456\u043D\u0438 \u043E\u0445\u043E\u0440\u043E\u043D\u0438:\n\n\u0427\u0435\u0440\u0435\u0437 \u0437\u0431\u0456\u0439 \u0443 \u043F\u043E\u0432\u0435\u0434\u0456\u043D\u043A\u043E\u0432\u0456\u0439 \u043C\u0430\u0442\u0440\u0438\u0446\u0456 \u041E\u0431'\u0454\u043A\u0442\u0430 \xAB\u041A\u043E\u043F\u0456\u044F\xBB \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u0438\u0439 \u0433\u0435\u0440\u043C\u043E\u0448\u043B\u044E\u0437 \u043F\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043D\u043E \u043D\u0430 \u0440\u0443\u0447\u043D\u0435 \u043A\u043E\u0434\u0443\u0432\u0430\u043D\u043D\u044F.\n\n\u0422\u0438\u043C\u0447\u0430\u0441\u043E\u0432\u0438\u0439 PIN-\u043A\u043E\u0434 \u0442\u0435\u0440\u043C\u0456\u043D\u0430\u043B\u0430 \xAB\u0415\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u0456\u043A\u0430-88\xBB: 1987.\n\n\u0423\u0412\u0410\u0413\u0410: \u041D\u0435 \u0440\u043E\u0437\u043C\u043E\u0432\u043B\u044F\u0439\u0442\u0435 \u0433\u043E\u043B\u043E\u0441\u043D\u043E \u043F\u043E\u0431\u043B\u0438\u0437\u0443 \u0432\u0435\u043D\u0442\u0438\u043B\u044F\u0446\u0456\u0439\u043D\u0438\u0445 \u0448\u0430\u0445\u0442 \u0421\u0435\u043A\u0442\u043E\u0440\u0430 \u0411 \u2014 \u0430\u043A\u0443\u0441\u0442\u0438\u0447\u043D\u0456 \u0441\u0435\u043D\u0441\u043E\u0440\u0438 \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F\u0443 \u0440\u0435\u0430\u0433\u0443\u044E\u0442\u044C \u043D\u0430 \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0439 \u0448\u0443\u043C!"
  pickupPaperNoise: 0.12
  unreadColor: {r: 0.95, g: 0.9, b: 0.72, a: 1}
  discoveredColor: {r: 0.75, g: 0.85, b: 0.75, a: 1}
  HasBeenDiscovered:
    UpdateTraits:
      MinSecondsBetweenUpdates: 0
      MaxSecondsBetweenUpdates: 0
    m_InternalValue: 0
